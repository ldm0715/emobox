{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EmoBox",
  "version": "0.1.2",
  "identifier": "com.emobox.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "EmoBox",
        "width": 1100,
        "height": 720,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "fullscreen": false
      },
      {
        "label": "quick-search",
        "title": "快捷搜索",
        "width": 680,
        "height": 500,
        "minWidth": 680,
        "minHeight": 500,
        "maxWidth": 680,
        "maxHeight": 500,
        "center": true,
        "resizable": false,
        "fullscreen": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "focus": true,
        "transparent": true,
        "shadow": false
      },
      {
        "label": "tray-menu",
        "title": "托盘菜单",
        "width": 248,
        "height": 162,
        "resizable": false,
        "fullscreen": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "focus": true,
        "transparent": true,
        "shadow": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/assets/emojis/**", "$APPDATA/assets/trash/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
